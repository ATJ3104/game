{
  "$schema": "node_modules/wrangler/config-schema.json",
  // OpenNext のアプリ本体に毎時の Cron を足した入口（worker.ts）
  "main": "worker.ts",
  "name": "mainichi-drill",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "mainichi-drill" }
  ],
  // 毎時0分（LINE のお知らせ。家族ごとの時刻になったら送る）
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mainichi-drill",
      // 本番用: `npx wrangler d1 create mainichi-drill` で表示された ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
